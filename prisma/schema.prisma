generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  phone        String?
  avatarUrl    String?
  role         UserRole      @default(ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownedStores  Store[]       @relation("StoreOwner")
  sentInvites  StoreInvite[] @relation("InviteSender")
  memberships  StoreMember[]
}

model Theme {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  previewImageUrl String?
  config          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stores          Store[]
}

model Store {
  id             String        @id @default(cuid())
  ownerId        String?
  name           String
  slug           String        @unique
  tagline        String?
  description    String?
  status         StoreStatus   @default(ACTIVE)
  plan           StorePlan     @default(STARTER)
  themeId        String?
  themeSettings  Json?
  phone          String?
  telegram       String?
  whatsapp       String?
  contactEmail   String?
  facebookUrl    String?
  instagramUrl   String?
  websiteUrl     String?
  location       String?
  qrCodeImageUrl String?
  logoUrl        String?
  heroImageUrl   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categories     Category[]
  products       Product[]
  owner          User?         @relation("StoreOwner", fields: [ownerId], references: [id])
  theme          Theme?        @relation(fields: [themeId], references: [id])
  invites        StoreInvite[]
  members        StoreMember[]
}

model Category {
  id          String    @id @default(cuid())
  storeId     String
  name_km     String
  name_en     String
  sortOrder   Int       @default(0)
  description String?
  isVisible   Boolean   @default(true)
  store       Store     @relation(fields: [storeId], references: [id])
  products    Product[]

  @@index([storeId, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  categoryId  String?
  name_km     String
  name_en     String
  price       Float
  description String?
  unit        String?
  sku         String?       @unique
  sortOrder   Int           @default(0)
  isFeatured  Boolean       @default(false)
  status      ProductStatus @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  category    Category?     @relation(fields: [categoryId], references: [id])
  store       Store         @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
}

model StoreMember {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(EDITOR)
  createdAt DateTime  @default(now())
  store     Store     @relation(fields: [storeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
}

model StoreInvite {
  id          String       @id @default(cuid())
  storeId     String
  email       String
  name        String?
  role        StoreRole    @default(EDITOR)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invitedBy   User?        @relation("InviteSender", fields: [invitedById], references: [id])
  store       Store        @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum StoreRole {
  OWNER
  ADMIN
  EDITOR
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum StorePlan {
  STARTER
  PRO
  ENTERPRISE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}
